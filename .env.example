# Used by Python ingestion scripts.
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# Used by dbt profile.
# These values should match the DATABASE_URL above.
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_SSLMODE=require

# dbt target schema prefix.
# In development, dbt will create schemas like dev_staging, dev_intermediate, dev_marts.
DBT_SCHEMA=dev

# Adzuna API credentials.
# These are not used in Sprint 0, but we define them now for future sprints.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Adzuna ingestion reliability settings.
ADZUNA_TIMEOUT_SECONDS=30
ADZUNA_MAX_RETRIES=3
ADZUNA_RETRY_BACKOFF_INITIAL_SECONDS=5
ADZUNA_RETRY_BACKOFF_MAX_SECONDS=60
ADZUNA_REQUEST_PAUSE_SECONDS=1

# General project settings.
APP_ENV=dev

# Orchestration settings.
ORCHESTRATOR_PIPELINE_NAME=job_market_warehouse_pipeline
ORCHESTRATOR_TRIGGER_TYPE=MANUAL
ORCHESTRATOR_DBT_TARGET=dev

